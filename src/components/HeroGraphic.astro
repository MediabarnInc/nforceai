---
/**
 * Homepage hero graphic: a calm mosaic of large rounded blocks on the hero's
 * light dawn gradient (no box). Translucent circles overlap the grid; a red leaf
 * and an aqua circle on apricot close the bottom row. Layers drift slightly with the pointer.
 */
import { shapePath, color, type Kind } from '../lib/shapes';

const CELL = 160;
const GAP = 16;
const S = CELL + GAP;
const W = 4 * CELL + 3 * GAP;
const span = (n = 1) => n * CELL + (n - 1) * GAP;

type B = { k: Kind; c: number; r: number; w?: number; h?: number; rot?: number; g: [string, string]; a?: 'd' | 'h' | 'v'; clean?: boolean };
const blocks: B[] = [
  { k: 'drop', c: 0, r: 0, g: ['violet', 'navy'] },
  { k: 'dome', c: 1, r: 0, g: ['terracotta', 'blush'], a: 'v' },
  { k: 'arch', c: 2, r: 0, h: 2, g: ['teal', 'navy'], a: 'v' },
  { k: 'circle', c: 3, r: 0, g: ['lavender', 'violet'] },
  { k: 'bullet', c: 0, r: 1, w: 2, g: ['navy', 'violet'], a: 'h' },
  { k: 'drop', c: 3, r: 1, rot: 90, g: ['teal', 'lavender'] },
  { k: 'leaf', c: 0, r: 2, g: ['violet', 'teal'] },
  { k: 'quarter', c: 1, r: 2, g: ['blush', 'violet'] },
  { k: 'dome', c: 2, r: 2, rot: 180, g: ['violet', 'blush'], a: 'v' },
  { k: 'arch', c: 3, r: 2, g: ['navy', 'teal'], a: 'v' },
  { k: 'bullet', c: 0, r: 3, w: 2, g: ['teal', 'lavender'], a: 'h' },
  { k: 'leaf', c: 2, r: 3, g: ['red', 'apricot'], a: 'v' },
];

// translucent circles that overlap the grid
const overlaps = [
  { cx: 0.55 * S + span(1.1) / 2, cy: 0.5 * S + span(1.1) / 2, r: span(1.1) / 2, f: 'lavender', o: 0.6 },
  { cx: 1.45 * S + span(0.9) / 2, cy: 2.45 * S + span(0.9) / 2, r: span(0.9) / 2, f: 'blush', o: 0.7 },
];

const pool = { cx: 3 * S + CELL / 2, cy: 3 * S + CELL / 2, r: CELL / 2 };
const dir = { d: [0, 0, 1, 1], h: [0, 0, 1, 0], v: [0, 0, 0, 1] } as const;
---
<div class="hero-art" data-hero-art aria-hidden="true">
  <svg viewBox={`-8 -8 ${W + 16} ${W + 16}`}>
    <defs>
      {blocks.map((b, i) => {
        const [x1, y1, x2, y2] = dir[b.a ?? 'd'];
        return (
          <linearGradient id={`hb${i}`} x1={x1} y1={y1} x2={x2} y2={y2}>
            <stop offset="0" style={`stop-color:${color(b.g[0])}`} />
            <stop offset="1" style={`stop-color:${color(b.g[1])}`} />
          </linearGradient>
        );
      })}
      <filter id="hero-grain" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
        <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" seed="4" result="noise" />
        <feColorMatrix in="noise" type="matrix" values="0 0 0 0 0.07  0 0 0 0 0.11  0 0 0 0 0.21  0 0 0 0.5 -0.1" result="speck" />
        <feComposite in="speck" in2="SourceGraphic" operator="in" result="grain" />
        <feMerge><feMergeNode in="SourceGraphic" /><feMergeNode in="grain" /></feMerge>
      </filter>
    </defs>

    <g class="layer" data-depth="-8">
      {blocks.map((b, i) => {
        const x = b.c * S, y = b.r * S, w = span(b.w), h = span(b.h);
        return (
          <g transform={b.rot ? `rotate(${b.rot} ${x + w / 2} ${y + h / 2})` : undefined}>
            <path class="blk" style={`--i:${i}`} d={shapePath(b.k, x, y, w, h)} fill={`url(#hb${i})`} opacity={b.clean ? 1 : 0.9} filter={b.clean ? undefined : "url(#hero-grain)"} />
          </g>
        );
      })}
    </g>

    <g class="layer" data-depth="16">
      {overlaps.map((o, i) => (
        <circle class="ovl" style={`--i:${i}`} cx={o.cx} cy={o.cy} r={o.r} fill={color(o.f)} opacity={o.o} />
      ))}
    </g>

    <g class="layer" data-depth="6">
      <defs>
        <linearGradient id="aqua-g" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" style="stop-color:var(--aqua)" />
          <stop offset="1" style="stop-color:var(--aqua-light)" />
        </linearGradient>
      </defs>
      <rect class="dot" x="110" y="16" width="112" height="40" rx="20" fill="var(--gold)" opacity="0.8" />
      <circle class="dot" cx={pool.cx} cy={pool.cy} r={pool.r} fill="url(#aqua-g)" />
    </g>
  </svg>
</div>

<style>
  .hero-art {
    position: absolute; top: 50%; right: max(var(--pad), calc((100vw - var(--max)) / 2));
    width: min(44vw, 620px); transform: translateY(-50%);
    pointer-events: none;
  }
  .hero-art svg { width: 100%; height: auto; overflow: visible; display: block; }
  .layer { transition: transform 700ms var(--ease); }
  .ovl { mix-blend-mode: multiply; }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .hero-art .blk {
      transform-box: fill-box; transform-origin: center;
      animation: blk-in 900ms var(--ease) both;
      animation-delay: calc(var(--i) * 60ms);
    }
    :global(.js) .hero-art .ovl {
      transform-box: fill-box; transform-origin: center;
      animation: pop 1000ms var(--ease) both;
      animation-delay: calc(800ms + var(--i) * 150ms);
    }
    :global(.js) .hero-art .dot { transform-box: fill-box; transform-origin: center; animation: pop 800ms var(--ease) 1100ms both; }
  }
  @keyframes blk-in { from { opacity: 0; transform: scale(0.6) rotate(-14deg); } }
  @keyframes pop { from { opacity: 0; transform: scale(0.4); } }
  @keyframes fade { from { opacity: 0; } }

  @media (max-width: 900px) {
    .hero-art { position: relative; top: auto; right: auto; transform: none; width: min(calc(100% - 2 * var(--pad)), 440px); margin: var(--s7) var(--pad); }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = window.matchMedia('(pointer: fine)').matches;
  const art = document.querySelector<HTMLElement>('[data-hero-art]');
  const hero = art?.closest('section');
  if (art && hero && !reduce && fine) {
    const layers = Array.from(art.querySelectorAll<SVGGElement>('[data-depth]'));
    let frame = 0, px = 0, py = 0;
    const paint = () => {
      frame = 0;
      layers.forEach((l) => {
        const d = Number(l.dataset.depth);
        l.style.transform = `translate(${px * d}px, ${py * d}px)`;
      });
    };
    hero.addEventListener('pointermove', (e) => {
      const r = hero.getBoundingClientRect();
      px = (e.clientX - r.left) / r.width - 0.5;
      py = (e.clientY - r.top) / r.height - 0.5;
      if (!frame) frame = requestAnimationFrame(paint);
    });
    hero.addEventListener('pointerleave', () => {
      px = 0; py = 0;
      if (!frame) frame = requestAnimationFrame(paint);
    });
  }
</script>
