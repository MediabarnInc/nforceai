---
import Arrow from './Arrow.astro';

interface Props {
  heading?: string;
  items: readonly { href: string; title: string; kind: string }[];
}
const { heading = 'Read the research', items } = Astro.props;
---
<section class="section--tight res" aria-label={heading}>
  <div class="wrap">
    <h2 data-reveal>{heading}</h2>
    <ul>
      {items.map((a, i) => (
        <li data-reveal style={`--delay:${i * 80}ms`}>
          <a href={a.href}>
            <span class="small muted">{a.kind}</span>
            <span class="t">{a.title}</span>
            <Arrow />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  h2 { margin-bottom: var(--s6); }
  ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--s5); }
  a { display: grid; gap: var(--s3); padding: var(--s5) 0; border-top: 3px solid var(--navy); text-decoration: none; }
  .t { font-size: 1.25rem; font-weight: 600; line-height: 1.35; letter-spacing: -0.01em; max-width: 34ch; }
  a:hover .t { text-decoration: underline; text-underline-offset: 0.2em; }
  a :global(svg) { width: 22px; height: 22px; }
</style>
