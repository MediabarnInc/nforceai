---
/**
 * One tile from the nForce shape kit, drawn on a 100-unit square.
 * Kinds come from DESIGN.md; colours must be palette tokens.
 */
export type ShapeKind =
  | 'quarter' | 'half' | 'circle' | 'ring' | 'square'
  | 'pill' | 'arch' | 'dots' | 'blank';

interface Props {
  kind: ShapeKind;
  fill?: string;
  bg?: string;
  rotate?: 0 | 90 | 180 | 270;
  class?: string;
  blend?: boolean;
  opacity?: number;
  /** Two palette colours: draws the shape with a grainy linear gradient */
  gradient?: [string, string];
  /** Gradient angle in degrees */
  angle?: number;
}

const { kind, fill = 'var(--navy)', bg, rotate = 0, class: cls = '', blend = false, opacity = 1, gradient, angle = 135 } = Astro.props;
const t = `rotate(${rotate} 50 50)`;
const uid = Math.random().toString(36).slice(2, 9);
const gid = `g${uid}`;
const nid = `n${uid}`;
const rad = (angle * Math.PI) / 180;
const gx = Math.cos(rad) * 50;
const gy = Math.sin(rad) * 50;
const paint = gradient ? `url(#${gid})` : fill;
---
<svg
  class:list={['shape', cls, { 'shape--blend': blend }]}
  viewBox="0 0 100 100"
  aria-hidden="true"
  preserveAspectRatio="none"
>
  {gradient && (
    <defs>
      <linearGradient id={gid} gradientUnits="userSpaceOnUse" x1={50 - gx} y1={50 - gy} x2={50 + gx} y2={50 + gy}>
        <stop offset="0" style={`stop-color:${gradient[0]}`} />
        <stop offset="1" style={`stop-color:${gradient[1]}`} />
      </linearGradient>
      <filter id={nid} x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
        <feTurbulence type="fractalNoise" baseFrequency="1.1" numOctaves="2" seed="7" result="noise" />
        <feColorMatrix in="noise" type="matrix" values="0 0 0 0 0.08  0 0 0 0 0.11  0 0 0 0 0.21  0 0 0 0.32 -0.06" result="speck" />
        <feComposite in="speck" in2="SourceGraphic" operator="in" result="grain" />
        <feMerge><feMergeNode in="SourceGraphic" /><feMergeNode in="grain" /></feMerge>
      </filter>
    </defs>
  )}
  {bg && <rect width="100" height="100" fill={bg} />}
  <g transform={t} fill={paint} opacity={opacity} filter={gradient ? `url(#${nid})` : undefined}>
    {kind === 'quarter' && <path d="M0 100V0a100 100 0 0 1 100 100z" />}
    {kind === 'half' && <path d="M0 100a50 50 0 0 1 100 0z" />}
    {kind === 'circle' && <circle cx="50" cy="50" r="50" />}
    {kind === 'ring' && <path fill-rule="evenodd" d="M50 0a50 50 0 1 1 0 100A50 50 0 0 1 50 0zm0 26a24 24 0 1 0 0 48 24 24 0 0 0 0-48z" />}
    {kind === 'square' && <rect x="0" y="0" width="100" height="100" />}
    {kind === 'pill' && <rect x="0" y="25" width="100" height="50" rx="25" />}
    {kind === 'arch' && <path d="M0 100V50a50 50 0 0 1 100 0v50z" />}
    {kind === 'dots' && (
      <>
        <circle cx="27" cy="27" r="15" /><circle cx="73" cy="27" r="15" />
        <circle cx="27" cy="73" r="15" /><circle cx="73" cy="73" r="15" />
      </>
    )}
  </g>
</svg>

<style>
  .shape { width: 100%; height: 100%; overflow: visible; }
  .shape--blend { mix-blend-mode: multiply; }
</style>
