---
import Base from './Base.astro';
import Shape from '../components/Shape.astro';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    kind: 'Article' | 'Case study' | 'Legal';
    intro?: string;
    updated?: string;
  };
}
const { title, description, kind, intro, updated } = Astro.props.frontmatter;
const crumb = kind === 'Legal' ? null : kind === 'Case study' ? 'Case studies' : 'Resources';
const pageUrl = new URL(Astro.url.pathname.replace(/\.html$/, ''), Astro.site).href;
const schema = kind === 'Legal' ? [] : [
  {
    '@type': 'Article',
    headline: title,
    description,
    url: pageUrl,
    mainEntityOfPage: pageUrl,
    image: new URL('/og.jpg', Astro.site).href,
    author: { '@id': new URL('/#organization', Astro.site).href },
    publisher: { '@id': new URL('/#organization', Astro.site).href },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: crumb },
      { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
    ],
  },
];
---
<Base title={title} description={description} type={kind === 'Legal' ? 'website' : 'article'} closeBand={kind !== 'Legal'} schema={schema}>
  <article>
    <header class="a-head grain grain-light ng-linen">
      <div class="wrap a-grid">
        <div>
          {crumb && (
            <nav aria-label="Breadcrumb" class="crumbs small muted">
              <a href="/">Home</a> <span aria-hidden="true">/</span> <span>{crumb}</span>
            </nav>
          )}
          <h1>{title}</h1>
          {intro && <p class="lead muted">{intro}</p>}
          {updated && <p class="small muted">{updated}</p>}
        </div>
        {kind !== 'Legal' && (
          <div class="a-art" aria-hidden="true">
            <Shape kind="circle" fill="var(--terracotta)" gradient={['var(--terracotta)', 'var(--blush)']} angle={60} blend />
            <Shape kind="circle" fill="var(--blush)" gradient={['var(--lavender)', 'var(--blush)']} angle={90} blend />
            <Shape kind="circle" fill="var(--gold)" gradient={['var(--gold)', 'var(--terracotta)']} angle={120} blend />
          </div>
        )}
      </div>
    </header>
    <div class="wrap a-body">
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</Base>

<style>
  .a-head { padding-block: clamp(48px, 7vw, 96px); }
  .a-grid { display: grid; grid-template-columns: 1fr auto; gap: var(--s7); align-items: end; }
  .crumbs { margin-bottom: var(--s5); }
  .crumbs a { color: inherit; }
  h1 { max-width: 24ch; margin-bottom: var(--s5); }
  h1:last-child { margin-bottom: 0; }
  .lead { max-width: 36rem; }
  .a-art { display: flex; }
  .a-art :global(svg) { width: 96px; height: 96px; }
  .a-art :global(svg + svg) { margin-left: -36px; }
  .a-body { padding-block: clamp(48px, 7vw, 96px); }
  .a-body .prose { margin-inline: auto; }
  @media (max-width: 760px) { .a-grid { grid-template-columns: 1fr; } .a-art { display: none; } }
</style>
